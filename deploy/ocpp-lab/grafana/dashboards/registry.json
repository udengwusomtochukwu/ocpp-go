        },
        "content": "<div style=\"height:100%;display:flex;align-items:flex-end;justify-content:space-between;padding:2px 4px 12px 4px;border-bottom:1px solid rgba(255,255,255,0.14);\"><div><div style=\"font-size:26px;line-height:1;letter-spacing:0.16em;color:#FFFFFF;font-weight:800;font-family:Inter,sans-serif;\">HYDE&nbsp;<span style=\"font-weight:300;color:#9E9E9E;\">REGISTRY</span></div><div style=\"margin-top:7px;font-size:11px;letter-spacing:0.08em;color:#8A8A8A;\">OCPP protocol internals · logs · traces</div></div><style>.hyde-mode[data-mode=\"live\"]{color:#3DDC5F;border-color:rgba(61,220,95,0.55);}.hyde-mode[data-mode=\"live\"]::after{content:\"LIVE DATA\";}.hyde-mode[data-mode=\"sim\"]{color:#F5A623;border-color:rgba(245,166,35,0.55);}.hyde-mode[data-mode=\"sim\"]::after{content:\"SIMULATION\";}.hyde-mode:not([data-mode=\"live\"]):not([data-mode=\"sim\"]){color:#9E9E9E;border-color:rgba(158,158,158,0.55);}.hyde-mode:not([data-mode=\"live\"]):not([data-mode=\"sim\"])::after{content:\"ALL DATA\";}</style><span class=\"hyde-mode\" data-mode=\"${mode}\" style=\"font-size:10px;letter-spacing:0.22em;border:1px solid;border-radius:999px;padding:4px 12px;margin-bottom:2px;white-space:nowrap;\"></span></div>"
      }
    },
    {
      "id": 10,
      "type": "row",
