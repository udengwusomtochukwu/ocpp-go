          "expr": "sum(ocpp_chargers_connected{mode=~\"$mode\"}) or vector(0)",
          "legendFormat": "connected"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connections + sessions per minute",
      "datasource": {
        "uid": "prometheus"
      },
      "description": "rate() over $__rate_interval with min step pinned to the 5s scrape interval, so short-lived churn shows at its true height instead of being averaged into a fixed 5m window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "insertNulls": 180000,
            "spanNulls": false
          },
          "unit": "opm",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tx started/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B08D57"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tx stopped/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8A8A8A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "conn opened/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C7C9CB"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "conn closed/min"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6B87A8"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ocpp_connections_opened_total{mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "conn opened/min",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ocpp_connections_closed_total{mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "conn closed/min",
          "interval": "5s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ocpp_transactions_started_total{mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "tx started/min",
          "interval": "5s"
        },
        {
          "refId": "D",
          "expr": "sum(rate(ocpp_transactions_stopped_total{mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "tx stopped/min",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Protocol activity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Registry events by type (per min)",
      "datasource": {
        "uid": "prometheus"
      },
      "description": "Fed by ocpp_events_total{type}. The three high-frequency plumbing types (heartbeat, meter, status) get their own series; everything else — boots, connects/disconnects, session starts/stops, command results — is collapsed into a single \"other\" series to keep the panel readable (max 5 hues). Session start/stop rates have their own panel above. Stacked bars use rate() over $__rate_interval with min step = the 5s scrape interval.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "insertNulls": 180000,
            "spanNulls": false
          },
          "unit": "opm",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#C7C9CB"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "heartbeat"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C7C9CB"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "meter"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6B87A8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B08D57"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8A8A8A"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(ocpp_events_total{type=~\"heartbeat|meter|status\",mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "{{type}}",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ocpp_events_total{type!~\"heartbeat|meter|status\",mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "other",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Command results by status (per min)",
      "datasource": {
        "uid": "prometheus"
      },
      "description": "Fed by ocpp_command_results_total{status}. Stacked bars use rate() over $__rate_interval with min step = the 5s scrape interval: a fixed [5m] window smeared bursts across neighbouring bars and mis-stacked peaks (Grafana community #82404). Finish-palette rule: bronze is excluded from the categorical rotation on any panel where alert-red can appear (fault codes, command statuses) — fallback order Silver → Steel → Graphite; burgundy (unused today) requires a CVD check against alert-red before ever appearing near alerts.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "insertNulls": 180000,
            "spanNulls": false
          },
          "unit": "opm",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#C7C9CB"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(?i)^(accepted|unlocked|scheduled|rebootrequired)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3DDC5F"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(?i)^(rejected|failed|faulted)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E5484D"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(?i)^(notsupported|notimplemented|occupied|blocked)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F5A623"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(ocpp_command_results_total{mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "{{status}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Faults by error code (per min)",
      "datasource": {
        "uid": "prometheus"
      },
      "description": "Fed by ocpp_faults_total{error_code}. Stacked bars use rate() over $__rate_interval with min step = the 5s scrape interval: a fixed [5m] window smeared bursts across neighbouring bars and mis-stacked peaks (Grafana community #82404). Known codes wear the neutral finish palette; unseen codes render alert-red until classified. Finish-palette rule: bronze is excluded from the categorical rotation on any panel where alert-red can appear (fault codes, command statuses) — fallback order Silver → Steel → Graphite; burgundy (unused today) requires a CVD check against alert-red before ever appearing near alerts.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "insertNulls": 180000,
            "spanNulls": false
          },
          "unit": "opm",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#E5484D"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "OtherError"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C7C9CB"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_code) (rate(ocpp_faults_total{mode=~\"$mode\"}[$__rate_interval]))*60",
          "legendFormat": "{{error_code}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Energy rate (booked at tx stop)",
      "datasource": {
        "uid": "prometheus"
      },
      "description": "Average delivery power DERIVED from ocpp_energy_wh_total, a counter that only increments when a transaction stops — so it shows bursty after-the-fact spikes, not live power. For true instantaneous power see the 'Charging power' gauge below (direct Power.Active.Import measurand).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "insertNulls": 180000,
            "spanNulls": false
          },
          "unit": "watt",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#C7C9CB"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ocpp_energy_wh_total{mode=~\"$mode\"}[$__rate_interval]))*3600",
          "legendFormat": "avg delivery W",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Charging telemetry (MeterValues measurands)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      }
    },
    {
      "id": 17,
      "type": "gauge",
      "title": "Charging power (instantaneous)",
      "datasource": {
        "uid": "prometheus"
      },
      "description": "Fed by the Power.Active.Import measurand from MeterValues (ocpp_power_w) — a DIRECT instantaneous reading, not derived from the energy counter via rate() (deriving power from cumulative energy is lossy and laggy — Grafana community #38310). Fleet-wide last report; zeroed when a transaction stops. The software sim never sends this measurand, so the gauge reads 'no charger reporting' unless a real charger is on a session. Scale spans the PEAK330-class machine (330 kW max boost; measured session peak so far: 147 kW).",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "max": 350000,
          "noValue": "no charger reporting",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3DDC5F",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
