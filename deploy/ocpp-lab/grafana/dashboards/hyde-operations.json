      "title": "OCPP Sessions (lab)",
      "type": "link",
      "url": "d/ocpp-sessions"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "OCPP Registry (lab)",
      "type": "link",
      "url": "d/ocpp-registry"
    },
    {
      "asDropdown": false,
      "icon": "bolt",
      "includeVars": false,
      "keepTime": false,
