  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div style=\"font-family:Manrope,system-ui,sans-serif;padding:6px 2px\"><span style=\"font-weight:800;letter-spacing:.02em\">HYDE</span><span style=\"font-weight:300;color:#9E9E9E\"> · OCPP Messages</span><div style=\"color:#8A8A8A;font-size:12px;margin-top:2px\">Live OCPP conversation from the charger — human-readable, filter by Message type. The vendor diagnostics equivalent.</div></div>"
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "OCPP message log",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"ocpp-central-system\"} | message =~ `$action` | mode=~`$mode` or mode=``"
        }
      ],
      "description": "Every OCPP message the charger sends/receives, filtered by the Message dropdown (like the vendor's log UI). Click a line to expand fields (client, message, mode, trace)."
    },
    {
      "id": 11,
      "type": "logs",
      "title": "FirmwareStatusNotification — update progression",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"ocpp-central-system\"} | message = `FirmwareStatusNotification`"
        }
      ],
      "description": "Firmware-over-the-air status: Downloading -> Downloaded -> Installing -> Installed (or *Failed). Watch a remote UpdateFirmware here."
    }
  ]
