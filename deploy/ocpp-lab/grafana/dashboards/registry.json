    "list": [
      {
        "current": {
          "selected": true,
          "text": "Live",
          "value": "live"
        },
        "description": "Global data mode. Live = real hardware on the LIVE_CHARGER_IDS allowlist; Simulation = every other charge-point id (internal sim, EXT01, test rigs); All = both. Prometheus series recorded before the mode label existed (pre 2026-07-21) only appear under All; Timescale history is backfilled and splits correctly.",
        "hide": 0,
        "includeAll": false,
        "label": "mode",
        "multi": false,
        "name": "mode",
        "options": [
          {
            "selected": true,
            "text": "Live",
            "value": "live"
          },
          {
            "selected": false,
            "text": "Simulation",
            "value": "sim"
          },
          {
            "selected": false,
            "text": "All",
            "value": ".*"
          }
        ],
        "query": "Live : live, Simulation : sim, All : .*",
        "queryValue": "",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
