    {
      "id": 1,
      "type": "stat",
      "title": "Chargers connected",
      "datasource": {
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F5A623",
                "value": null
              },
              {
                "color": "#3DDC5F",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ocpp_chargers_connected{mode=~\"$mode\"}) or vector(0)"
        }
      ]
    },
