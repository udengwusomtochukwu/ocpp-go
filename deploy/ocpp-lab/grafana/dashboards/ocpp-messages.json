  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div style=\"font-family:Manrope,system-ui,sans-serif;padding:6px 2px\"><span style=\"font-weight:800;letter-spacing:.02em\">HYDE</span><span style=\"font-weight:300;color:#9E9E9E\"> · OCPP Messages</span><div style=\"color:#8A8A8A;font-size:12px;margin-top:2px\">The live OCPP conversation with the charger, one readable line per message. Click a line to expand it — the <b>payload</b> field holds the complete object as sent. Filter by Message type, Direction and mode.</div></div>"
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "OCPP message log — full payload",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"ocpp-central-system\"} | message =~ `$action` | mode=~`$mode` or mode=`` | dir =~ `$dir`"
        }
      ],
      "description": "One readable line per OCPP message — what happened, on which connector, with which code (e.g. 'connector 1 is Charging', 'FAULT on connector 1 at … — OtherError (vendor 2): Hflash is busy now', 'Transaction 1011 stopped (Local) — meter 1287200 Wh, 104 meter sample(s) incl. signed OCMF data'). CLICK ANY LINE to expand its fields: `payload` holds the COMPLETE object exactly as the charger sent it (boot identity, every meter sample, the receipt block), alongside client / message / dir / mode. Filter by Message type, Direction (Received/Sent) and mode. Payloads are carried whole up to 48 KB — which covers every session observed so far (a 34-min charge is ~35 KB, the longest on record ~45 KB). The cap exists because `payload` is Loki structured metadata, limited to 64 KB, and this Loki rejects an over-limit entry outright rather than trimming it; clipping a rare giant beats losing the whole message. Raw samples always remain in Timescale (HYDE · Sessions)."
    },
    {
      "id": 11,
      "type": "logs",
      "title": "FirmwareStatusNotification — update progression",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"ocpp-central-system\"} | message = `FirmwareStatusNotification` | dir = `in`"
        }
      ],
      "description": "Firmware-over-the-air status: Downloading -> Downloaded -> Installing -> Installed (or *Failed). Watch a remote UpdateFirmware here."
    }
  ]
