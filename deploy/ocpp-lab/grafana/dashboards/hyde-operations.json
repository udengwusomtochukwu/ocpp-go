{
  "uid": "hyde-operations",
  "title": "HYDE · Operations",
  "description": "Day-to-day health of the charging lab for the operations team: backend and charger connectivity, freshness of charger reports, session and connection churn, command outcomes, faults with their matching log lines, per-gun service state and the buffer battery. Truth-first: 'No data' means nothing was reported (only counts are zero-filled), sessions are ordered by time (never by transaction id, which resets on redeploys), and in-progress sessions are never given a final verdict. Times display in your browser's timezone (site local time is Central European, CEST). Alert rules live in the Grafana folder 'OCPP Lab' — link at the bottom.",
  "tags": [
    "hyde",
    "ocpp",
    "lab"
  ],
  "timezone": "browser",
  "weekStart": "monday",
  "graphTooltip": 1,
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
